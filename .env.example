REPORT_BOT_TOKEN=
# Catch-all admin GROUP chat id(s), comma-separated. Must be a GROUP (negative id, e.g. -100…).
TELEGRAM_ADMIN_CHAT_ID=
# Optional: the supervisor daemon's control channel — a PRIVATE chat id (positive, your user id).
# Only needed if you run `node scripts/daemon.mjs`. The daemon validates that this is private.
DAEMON_CHAT_ID=
# Optional: skip auto-reminders during these hours (0–23, END exclusive, wraps midnight).
# Example for 22:00–07:59: START=22, END=8. Leave unset for 24/7 reminders.
# Uses the listener process's local timezone — set `TZ=Asia/Ho_Chi_Minh` in the same
# env if running under a service manager whose host TZ differs from yours.
QUIET_HOURS_START=
QUIET_HOURS_END=
