# .env holds SECRETS ONLY. Non-secret config (default group, daemon DM, etc.)
# lives in projects.json `_config` — see projects.sample.json.
REPORT_BOT_TOKEN=
# (Optional secret) Gemini API key, if any tooling uses it.
GEMINI_API_KEY=
# NOTE: non-secret config (default group, daemon DM, quiet hours, roles) lives in
# projects.json — see projects.sample.json (`_config` and `_default` blocks).
# (Legacy TELEGRAM_ADMIN_CHAT_ID / DAEMON_CHAT_ID / QUIET_HOURS_* in .env are still
#  read as a DEPRECATED fallback — they work but log a warning; move them to projects.json.)
# Set TZ here only if the host timezone differs from yours (quiet hours use local time):
# TZ=Asia/Ho_Chi_Minh
