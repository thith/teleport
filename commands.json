{
  "spawn":    { "run": "spawn.mjs",   "args": ["--interactive"], "needsProject": true,  "minRole": "maintainer", "desc": "launch an interactive agent in <project>" },
  "headless": { "run": "spawn.mjs",   "args": [],                "needsProject": true,  "minRole": "maintainer", "desc": "launch a headless agent in <project>" },
  "kill":     { "run": "spawn.mjs",   "args": ["--kill"],        "needsProject": false, "minRole": "maintainer", "desc": "kill an agent by id/hashtag" },
  "ls":       { "run": "spawn.mjs",   "args": ["--list"],        "needsProject": false, "minRole": "member",     "desc": "list running agents" },
  "run":      { "run": "run.mjs",     "args": [],                "needsProject": true,  "minRole": "maintainer", "desc": "run a package.json script: /run <project> <script> [args]" },
  "whisper":  { "run": "whisper.mjs", "args": [],                "needsProject": false, "minRole": "admin",      "wantsReplyText": true, "desc": "discreet steer into a topic: /whisper #<hash> <text> (or reply to a previous whisper)" },
  "instruct": { "run": "instruct.mjs","args": [],                "needsProject": false, "minRole": "admin",      "wantsReplyText": true, "desc": "official private instruction to a topic; agent replies via DM: /instruct #<hash> <text> (or reply to continue)" },
  "pending":  { "run": "pending.mjs", "args": [],                "needsProject": false, "minRole": "member",     "desc": "list convos waiting on an admin reply" },
  "broadcast":{ "run": "broadcast.mjs","args": [],                "needsProject": false, "minRole": "admin",      "desc": "system message to ALL live topics: /broadcast [--chat <id>] <text>" },
  "start":    { "run": "start.mjs",   "args": [],                "needsProject": false, "minRole": "public",     "desc": "onboarding help" },
  "cswap":    { "run": "cswap.mjs",   "args": [],                "needsProject": false, "minRole": "maintainer", "desc": "Claude account switcher: /cswap = list accounts, /cswap <n> = switch to account n" },
  "w":        { "alias": "whisper" },
  "i":        { "alias": "instruct" }
}
